# Better Auth Secret (Generate via `openssl rand -hex 32`)
BETTER_AUTH_SECRET="dev-secret-change-in-production-random-hex"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth Credentials (Optional - for Cloud Sync)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudflare D1 Credentials (Optional - if left empty, app operates offline with local fallback)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_D1_DATABASE_ID=""
